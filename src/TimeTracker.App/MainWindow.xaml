<Window
    x:Class="TimeTracker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TimeTracker">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsSettingsVisible="False" SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard" IsSelected="True" />
            <NavigationViewItem Content="History" Icon="Clock" Tag="history" />
            <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
