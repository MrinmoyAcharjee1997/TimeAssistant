<Page
    x:Class="TimeTracker.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TimeTracker.App.ViewModels">
    <Grid Padding="36,28">
        <StackPanel Spacing="24" MaxWidth="920">
            <StackPanel Spacing="6">
                <TextBlock Text="TIME TRACKER" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" CharacterSpacing="80" />
                <TextBlock Text="Your time, visible." Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Track an activity now. Each action is immediately appended to your local Markdown file." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="24">
                <StackPanel Spacing="18">
                    <TextBlock Text="NOW TRACKING" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentActivity, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Elapsed, Mode=OneWay}" FontFamily="Consolas" FontSize="42" FontWeight="SemiBold" />
                    <ComboBox
                        Header="Activity"
                        Width="360"
                        HorizontalAlignment="Left"
                        PlaceholderText="Pick a task to track or switch to"
                        ItemsSource="{x:Bind ViewModel.Activities}"
                        SelectedItem="{x:Bind ViewModel.SelectedActivity, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" MaxWidth="310" TextWrapping="Wrap" TextTrimming="None" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Start / switch" Command="{x:Bind ViewModel.StartOrSwitchCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Pause / resume" Command="{x:Bind ViewModel.PauseOrResumeCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2" Content="Stop" Command="{x:Bind ViewModel.StopCommand}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.TrackingStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="LOCAL DATA" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StorageState, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StorageDetail, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12,8">
                        <TextBlock Text="{x:Bind ViewModel.StoragePath, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Append-only tracking" Message="Start, pause, resume, stop, and switching events are written as readable dated lines. Session totals come in the next step." />
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsValidating, Mode=OneWay}">
                <ProgressRing IsActive="True" Width="18" Height="18" />
                <TextBlock Text="Checking the time log…" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasLogIssues, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="Log needs repair" Message="{x:Bind ViewModel.LogIssueMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Repair log" Command="{x:Bind ViewModel.RepairLogCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </Grid>
</Page>
